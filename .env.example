# =============================================================================
# DICA SCM & Inventory Admin Portal — Environment Variables Example
# =============================================================================

# NestJS Backend API Endpoint (Prefix: /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Application Identity & Branding
NEXT_PUBLIC_APP_NAME="DICA Admin"
NEXT_PUBLIC_APP_DESCRIPTION="Hệ Thống Quản Trị Chuỗi Cung Ứng & Tồn Kho F&B"

# Offline / Demo Fallback Mode (true: tự động dùng mock khi backend offline)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Default Theme Mode: light | dark | system
NEXT_PUBLIC_DEFAULT_THEME=system
