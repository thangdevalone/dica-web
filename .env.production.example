# =============================================================================
# DICA Web Production Environment Configuration
# Copy this file to /opt/dica-web/.env.production on the target VPS
# =============================================================================

# Port on the VPS host (bound to 127.0.0.1 and proxied by Nginx)
WEB_PORT=3001

# Public API URL (baked during build if set in GH Actions, or configurable if using rewrites)
# - Unified Domain (Recommended): /api/v1 (proxied by Nginx to backend:3000)
# - Subdomain: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Default organization code pre-filled on the login screen
NEXT_PUBLIC_DEFAULT_ORGANIZATION_CODE=DICA

# Application Identity & Branding
NEXT_PUBLIC_APP_NAME="DICA Admin"
NEXT_PUBLIC_APP_DESCRIPTION="Hệ Thống Quản Trị Chuỗi Cung Ứng & Tồn Kho F&B"

# Default Theme Mode: light | dark | system
NEXT_PUBLIC_DEFAULT_THEME=system
